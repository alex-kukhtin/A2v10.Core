<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.0: loads in both MSBuilds — Visual Studio (.NET Framework) and dotnet -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<Version>10.1.8668</Version>
		<Nullable>enable</Nullable>
		<LangVersion>Latest</LangVersion>
		<PackageId>A2v10.CheckUpdates</PackageId>
		<Description>A2v10: build-time warning when a newer platform generation is published</Description>
		<Authors>Oleksandr Kukhtin</Authors>
		<Company>Oleksandr Kukhtin</Company>
		<Copyright>Copyright © 2026 Oleksandr Kukhtin. All rights reserved.</Copyright>
		<RepositoryType>github</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- consumer gets PrivateAssets=all automatically -->
		<DevelopmentDependency>true</DevelopmentDependency>
		<!-- the dll goes to tasks/, not lib/: the app references nothing -->
		<BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<!-- NU5100: dll outside lib/ is intended; NU5128: no lib/ ref assemblies is intended -->
		<NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
		<IncludeSymbols>false</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.*" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\A2v10.CheckUpdates.targets" Pack="true" PackagePath="build\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
