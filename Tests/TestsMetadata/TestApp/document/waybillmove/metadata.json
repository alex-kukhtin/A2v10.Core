{
	"$schema": "../../../../../Platform/A2v10.App.Assets2026/Application/@schemas/metadata-endpoint-json-schema.json#",
	"storage": "/document",
	"autonum": "waybill",
	"initialValues": {
		"StoreFrom": {
			"source": "profile",
			"value": "Store"
		},
		"Agent": {
			"source": "profile",
			"value": "Agent"
		},
		"Date": {
			"source": "context",
			"value": "today"
		}
	},
	"rules": {
		"required": [ "StoreFrom", "StoreTo", "Agent" ]
	},
	"post": [
		{
			"journal": "/journal/stock",
			"dir": "out",
			"each": { "details": "Rows", "kinds": ["Stock"] },
			"document": {
				"Store": "StoreTo"
			}
		},
		{
			"journal": "/journal/stock",
			"dir": "in",
			"each": {
				"details": "Rows",
				"kinds": [ "Stock" ]
			},
			"document": {
				"Store": "StoreFrom"
			}
		}
	]
} 
