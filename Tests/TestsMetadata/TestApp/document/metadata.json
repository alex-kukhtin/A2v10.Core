{
	"$schema": "../../../../Platform/A2v10.App.Assets2026/Application/@schemas/metadata-endpoint-json-schema.json#",
	"table": "StockDocuments",
	"model": "Document",
	"traits": [ "Attachments" ],
	"fields": {
		"Number": {
			"type": "Autonum"
		},
		"Operation": {
			"type": "Operation"
		},
		"Company": {
			"type": "Company",
			"target": "/catalog/company"
		},
		"StoreFrom": {
			"type": "Ref",
			"target": "/catalog/store"
		},
		"StoreTo": {
			"type": "Ref",
			"target": "/catalog/store"
		},
		"Agent": {
			"type": "Ref",
			"target": "/catalog/agent"
		},
		"Contract": {
			"type": "Ref",
			"target": "/catalog/contract"
		},
		"State": {
			"type": "State",
			"target": "/state/order"
		},
		"Sum": {
			"type": "Amount"
		},
		"DueDate": {
			"type": "Date"
		},
		"Order": {
			"type": "BasedOn",
			"target": "/document/order"
		},
		"Shipment": {
			"type": "BasedOn",
			"target": "/document/waybillout"
		}
	},
	"rules": {
		"required": [ "Date" ]
	},
	"properties": {
		"Sum": { "get": "this.StockRows.$sum(r => r.Sum) + this.ServiceRows.$sum(r => r.Sum)" }
	},
	"details": {
		"Rows": {
			"model": "Row",
			"fields": {
				"Kind": {
					"type": "RowKind"
				},
				"Qty": {
					"type": "Qty"
				},
				"Cost": {
					"type": "Amount",
					"sqlAs": "[Qty] * [Price]"
				},
				"Price": {
					"type": "Price"
				},
				"Sum": {
					"type": "Amount"
				},
				"Item": {
					"type": "Ref",
					"target": "/catalog/item"
				},
				"Unit": {
					"type": "Ref",
					"target": "/catalog/unit"
				},
				"VatRate": {
					"type": "Enum",
					"target": "/enum/vatrate"
				},
				"Contract": {
					"type": "Ref",
					"target": "/catalog/contract"
				}
			},
			"lookup": {
				"Item": [ "Article", "Barcode" ]
			},
			"rules": {
				"inherit": {
					"Unit": {
						"ref": "Item",
						"field": "Unit"
					},
					"VatRate": {
						"ref": "Item",
						"field": "VatRate"
					}
				}
			},
			"kinds": {
				"Stock": {
					"properties": {
						"Sum": { "get": "this.Qty * this.Price" }
					},
					"rules": {
						"required": [ "Item", "Qty", "Price" ]
					}
				},
				"Service": {
					"properties": {
						"Sum": { "get": "this.Qty * this.Price", "set": "this.Qty = value / this.Price" },
						"$Base": { "type": "Amount", "get": "this.Qty * this.Price" }
					},
					"rules": {
						"required": [ "Item" ]
					}
				}
			}
		}
	}
}