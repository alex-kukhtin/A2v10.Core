{
	"$schema": "../../../../../Platform/A2v10.App.Assets2026/Application/@schemas/metadata-endpoint-json-schema.json#",
	"storage": "/document",
	"autonum": "waybill",
	"initialValues": {
		"StoreFrom": {
			"source": "profile",
			"value": "Store"
		},
		"Agent": {
			"source": "profile",
			"value": "Agent"
		},
		"Date": {
			"source": "context",
			"value": "today"
		}
	},
	"rules": {
		"required": [ "StoreTo", "Agent" ]
	},
	"post": [
		{
			"journal": "/journal/stock",
			"dir": "in",
			"each": {
				"details": "Rows",
				"kinds": [ "Stock" ]
			},
			"document": {
				"Store": "StoreFrom"
			}
		}
	],
	"printForms": [{"path": "print/printform1", "title": "Прибуткова накладна", "header": "ПН № {Document.Number} від {Document.Date}"}]
} 
