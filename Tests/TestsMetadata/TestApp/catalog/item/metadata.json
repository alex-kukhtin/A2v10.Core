{
	"$schema": "../../../../../Platform/A2v10.App.Assets2026/Application/@schemas/metadata-endpoint-json-schema.json#",
	"table": "Items",
	"traits": [ "Folders" ],
	"fields": {
		"Unit": {
			"type": "Ref",
			"target": "/catalog/unit"
		},
		"VatRate": {
			"type": "Enum",
			"target": "/enum/vatrate"
		},
		"Article": {
			"type": "String",
			"length": 32
		},
		"Barcode": {
			"type": "String",
			"length": 32,
			"unique": true
		}
	},
	"lookup": {
		"Article": "contains",
		"Barcode": "equal"
	},
	"initialValues": {
		"VatRate": { "source": "literal", "value": "20" }
	},
	"rules": {
		"required": [ "VatRate", "Name" ]
	}
}