{
	"$schema": "../../../../../Platform/A2v10.App.Assets2026/Application/@schemas/metadata-endpoint-json-schema.json#",
	"table": "PriceLists",
	"model": "PriceList",
	"fields": {
		"IsVat": {
			"type": "Boolean"
		},
		"VatIncluded": {
			"type": "Boolean"
		},
		"Manual": {
			"type": "Boolean"
		}
	},
	"details": {
		"Rows": {
			"model": "PriceRow",
			"fields": {
				"Item": {
					"type": "Ref",
					"target": "/catalog/item"
				},
				"VatRate": {
					"type": "Enum",
					"target": "/enum/vatrate"
				},
				"Qty": {
					"type": "Qty"
				},
				"Price": {
					"type": "Price"
				},
				"Sum": {
					"type": "Amount"
				},
				"Vat": {
					"type": "Amount"
				},
				"Total": {
					"type": "Amount"
				}
			},
			"rules": {
				"inherit": {
					"VatRate": {
						"ref": "Item",
						"field": "VatRate"
					}
				},
				"vat": {
					"Qty": "Qty",
					"Price": "Price",
					"Rate": "VatRate.Rate",
					"Sum": "Sum",
					"Vat": "Vat",
					"Total": "Total",
					"IsVat": "$root.PriceList.IsVat",
					"Included": "$root.PriceList.VatIncluded",
					"Manual": "$root.PriceList.Manual"
				}
			}
		}
	}
}
