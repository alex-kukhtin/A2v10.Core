@model MainViewModel
@inject IAppCodeProvider codeProvider
@inject ICurrentUser currentUser
@inject IAppVersion appVersion
@inject IApplicationTheme appTheme
@inject IGlobalization globalization
@inject IAppRuntimeBuilder runtimeBuilder

@{
	IUserLocale userLocale = currentUser.Locale;
	String minify = Model?.Minify ?? String.Empty;
}

<!DOCTYPE html>
<!--
A2v10 platform.
Copyright © 2015-2026 Oleksandr Kukhtin. All rights reserved.
Site: https://a2v10.com
GitHub: https://github.com/alex-kukhtin/A2v10.Core
-->
<html lang="@userLocale.Language" class="@appTheme.HtmlCssClass">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="format-detection" content="telephone=no" />
	<meta name="google" content="notranslate" />
	<meta name="helpUrl" content="@Model?.HelpUrl" />
	<meta name="rootUrl" content="" />
	<title></title>
	@Html.Raw(Model?.Theme)
	@Html.Raw(await codeProvider.LayoutStyles())
	@Html.Raw(codeProvider.AppStyleSheetsLink())
	@* a2v10spreadsheet.css: off until its Vue 3 build exists
	@Html.Raw(runtimeBuilder.MetadataStyles(minify))
	*@
	<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
	<link rel="icon" href="/favicon.ico" type="image/x-icon" />
	@Html.Raw(Model?.ModelStyles)
</head>
<body class="@appTheme.BodyCssClass">
	@RenderBody()
	<script type="text/javascript" src="/scripts/signalr.min.js?v=8.0.7"></script>
	<script type="text/javascript" src="/scripts/locale-@Html.Raw(userLocale.Language + ".min.js")?v=@appVersion.AppBuild"></script>
	@Html.Raw(globalization.SwitchLocale())
	@* in place of vue + tabmain + tabbed; built in A2v10.Vue3.Core (CORE-VUE3.md). The core holds Vue *@
	<script type="text/javascript" src="/scripts/vue3/a2v10-core.@Html.Raw(minify)js?v=@appVersion.AppBuild"></script>
	<script type="text/javascript" src="/scripts/vue3/a2v10-shell-tabbed.@Html.Raw(minify)js?v=@appVersion.AppBuild"></script>
	<script type="text/javascript" src="/scripts/vue3/a2v10-xaml.@Html.Raw(minify)js?v=@appVersion.AppBuild"></script>
	@* a2v10spreadsheet.js: off until its Vue 3 build exists
	@Html.Raw(runtimeBuilder.MetadataScripts(minify))
	*@
	@Html.Raw(await codeProvider.LayoutScripts())
	@Html.Raw(codeProvider.AppScriptsLink())
	@Html.Raw(Model?.ModelScripts)
	<script type="text/javascript" src="/_shell/script"></script>
</body>
</html>
