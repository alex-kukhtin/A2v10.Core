{
	"$schema": "http://json-schema.org/draft-04/schema",
	"$version": "10.1.8670",
	"$date": "2026-10-06",
	"title": "JSON Schema for app.json",
	"type": "object",

	"properties": {
		"$schema": { "type": "string" },
		"platformid": {
			"type": "string",
			"enum": [ "bigint", "int", "uniqueidentifier" ]
		},
		"useGrants": { "type": "boolean" },
		"roles": {
			"description": "The application's roles: the key is the role, PascalCase, the one 'grants' names; 'Admin' and 'Everyone' are the platform's and are not declared. The deploy writes them to a2security.Roles; a role taken out of the map becomes void, put back it is restored. No 'roles' - the table is left alone; an empty map voids every role.",
			"type": "object",
			"patternProperties": {
				"^[A-Z][A-Za-z0-9]{0,63}$": {
					"type": "object",
					"properties": {
						"Name": { "type": "string", "minLength": 1, "maxLength": 255 },
						"Memo": { "type": "string", "maxLength": 255 }
					},
					"required": [ "Name" ],
					"additionalProperties": false
				}
			},
			"not": { "anyOf": [ { "required": [ "Admin" ] }, { "required": [ "Everyone" ] } ] },
			"additionalProperties": false
		},
		"boundary": {
			"description": "The catalogs the user's boundary is cut by - places people answer for (a store, a legal entity): \"/catalog/store\". A field pointing at one of them is under the boundary unless 'skipBoundary' takes it out. No 'boundary' - nothing is cut. Declared only: the platform does not enforce the boundary yet.",
			"type": "array",
			"items": { "type": "string", "pattern": "^/[a-z0-9_-]+/[a-z0-9_-]+$" },
			"uniqueItems": true
		},
		"aliases": {
			"description": "More folders of one kind: \"document\": [\"sale\"] makes sale/invoice the endpoint /sale/invoice of kind document. An operation's Id stays the last segment.",
			"type": "object",
			"properties": {
				"catalog": { "$ref": "#/definitions/aliasFolders" },
				"document": { "$ref": "#/definitions/aliasFolders" },
				"journal": { "$ref": "#/definitions/aliasFolders" },
				"report": { "$ref": "#/definitions/aliasFolders" },
				"enum": { "$ref": "#/definitions/aliasFolders" },
				"state": { "$ref": "#/definitions/aliasFolders" },
				"accplan": { "$ref": "#/definitions/aliasFolders" },
				"ledger": { "$ref": "#/definitions/aliasFolders" }
			},
			"additionalProperties": false
		},
		"title": { "type": "string" },
		"copyright": { "type": "string" },
		"appLogo": { "type": "string" },
		"links": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": { "type": "string" },
					"url": {
						"type": "string",
						"pattern": "^[\/|http|https].+"
					}
				},
				"additionalProperties": false
			}
		},
		"profileMenu": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": { "type": "string" },
					"icon": { "type": "string" },
					"type": {
						"type": "string",
						"enum": [ "dialog", "page", "external", "separator" ]
					},
					"url": {
						"type": "string",
						"pattern": "^[\/|http|https].+"
					}
				},
				"additionalProperties": false
			}
		}

	},
	"additionalProperties": false,
	"definitions": {
		"aliasFolders": {
			"type": "array",
			"items": { "type": "string" },
			"uniqueItems": true
		}
	}
}
