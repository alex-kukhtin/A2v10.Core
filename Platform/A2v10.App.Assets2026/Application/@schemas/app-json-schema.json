{
	"$schema": "http://json-schema.org/draft-04/schema",
	"$version": "10.1.8662",
	"$date": "2026-09-18",
	"title": "JSON Schema for app.json",
	"type": "object",

	"properties": {
		"$schema": { "type": "string" },
		"platformid": {
			"type": "string",
			"enum": [ "bigint", "int", "uniqueidentifier" ]
		},
		"useGrants": { "type": "boolean" },
		"title": { "type": "string" },
		"copyright": { "type": "string" },
		"appLogo": { "type": "string" },
		"links": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": { "type": "string" },
					"url": {
						"type": "string",
						"pattern": "^[\/|http|https].+"
					}
				},
				"additionalProperties": false
			}
		},
		"profileMenu": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": { "type": "string" },
					"icon": { "type": "string" },
					"type": {
						"type": "string",
						"enum": [ "dialog", "page", "external", "separator" ]
					},
					"url": {
						"type": "string",
						"pattern": "^[\/|http|https].+"
					}
				},
				"additionalProperties": false
			}
		}

	},
	"additionalProperties": false
}
