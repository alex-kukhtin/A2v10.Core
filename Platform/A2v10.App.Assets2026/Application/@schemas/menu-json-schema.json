{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$version": "10.1.8675",
	"$date": "2026-11-17",
	"title": "JSON Schema for menu.json",
	"description": "The menu: sections (first level), subsections (second), items (third), the rows of an aux (fourth). The level gives the role, and each role reads its own keys: a key off its level is not read - silently.",
	"type": "object",
	"required": [ "menu" ],
	"additionalProperties": false,

	"properties": {
		"$schema": { "type": "string" },
		"appTitle": {
			"description": "What the user sees in the title: not the name of the application, its folder or its database.",
			"type": "string"
		},
		"columns": {
			"description": "Columns of the section panel the second-level items are laid out in; 1 when absent.",
			"type": "integer",
			"minimum": 1
		},
		"menu": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/menuItem"
			}
		}
	},

	"definitions": {
		"icon": {
			"type": "string",
			"enum": [
				"access", "account", "account-folder", "add", "address-book", "address-card", "alert", "apply", "approve", "arrow-down", "arrow-down-red", "arrow-export", "arrow-left", "arrow-left-right", "arrow-left-right-full", "arrow-open", "arrow-right", "arrow-sort", "arrow-up", "arrow-up-green", "assets", "attach",
				"ban", "bank", "bank-account", "bank-uah", "barcode", "bell", "board", "bookmark", "brand-excel",
				"calc", "calendar", "calendar-today", "calendar-week", "call", "camera", "cart", "chart-area", "chart-bar", "chart-column", "chart-pie", "chart-pivot", "chart-stacked-area", "chart-stacked-bar", "chart-stacked-line", "check", "check-bold", "checkbox", "checkbox-checked", "chevron-double-left", "chevron-double-right", "chevron-down", "chevron-left", "chevron-left-end", "chevron-right", "chevron-right-end", "chevron-up", "circle", "circle-small", "clear", "close", "cloud", "cloud-outline", "code", "code-check", "comment", "comment-add", "comment-discussion", "comment-lines", "comment-next", "comment-outline", "comment-previous", "comment-urgent", "company", "confirm", "copy", "currency-euro", "currency-other", "currency-uah", "currency-usd", "cut",
				"dashboard", "dashboard-outline", "database", "delete", "delete-box", "delete-red", "devices", "disapprove", "dot", "dot-blue", "dot-green", "dot-red", "download",
				"edit", "edit-redo", "edit-undo", "ellipsis", "ellipsis-bottom", "ellipsis-vertical", "error", "error-outline", "exit", "export", "export-excel", "external", "eye", "eye-disabled", "eye-disabled-red",
				"factory", "failure", "failure-outline", "failure-red", "file", "file-content", "file-download-pdf", "file-error", "file-failure", "file-image", "file-import", "file-link", "file-preview", "file-signature", "file-success", "file-user", "file-warning", "filter", "filter-outline", "flag", "flag-blue", "flag-green", "flag-red", "flag-yellow", "flag2", "flame", "folder", "folder-ban", "folder-move-to", "folder-outline", "folder-query", "folders-outline",
				"gear", "gear-outline", "grid",
				"help", "help-blue", "help-outline", "history", "home",
				"image", "import", "info", "info-blue", "info-outline", "items",
				"link", "list", "list-bullet", "lock", "lock-outline", "log", "logout",
				"menu", "message", "message-outline", "minus", "minus-box", "minus-circle", "mode-dark", "mode-light",
				"package", "package-outline", "pane-close", "pane-left", "pane-left-blue", "pane-open", "pane-right", "pane-right-blue", "paste", "pencil", "pencil-outline", "personnel", "pin", "pin-outline", "pinned", "pinned-outline", "play", "play-outline", "plus", "plus-box", "plus-circle", "policy", "power", "print", "process",
				"qrcode", "query", "queue",
				"refresh", "reload", "rename", "report", "requery",
				"save", "save-as", "save-close", "save-close-outline", "save-outline", "search", "security", "send", "send-outline", "server", "share", "smile", "smile-sad", "square", "star", "star-outline", "star-yellow", "step", "steps", "storyboard", "success", "success-green", "success-outline", "switch",
				"table", "tag", "tag-blue", "tag-green", "tag-outline", "tag-red", "tag-yellow", "task-complete", "trash", "triangle-left", "triangle-right", "truck",
				"unapply", "unlock", "unlock-outline", "unpin", "unpin-outline", "upgrade", "upload", "upload2", "user", "user-image", "user-minus", "user-plus", "users",
				"variable",
				"waiting", "waiting-outline", "warehouse", "warning", "warning-outline", "warning-yellow", "workflow1", "wrench"			
			]
		},
		"menuItem": {
			"type": "object",
			"additionalProperties": false,

			"properties": {
				"title": {
					"description": "Every level. '@[Key]' is a localization key, anything else a literal.",
					"type": "string"
				},

				"icon": {
					"description": "A section only: the strip on the left is the one place an icon is drawn.",
					"$ref": "#/definitions/icon"
				},

				"endpoint": {
					"type": "string",
					"description": "A leaf only - an item, or a row of an aux. The endpoint it opens: /<kind>/<endpoint>. Not a page address: the menu adds the action and the id."
				},

				"id": {
					"description": "An aux only: an item with 'items', which opens a two-pane browser of them.",
					"type": "string"
				},

				"category": {
					"description": "A row of an aux only: the group it is listed under in the browser.",
					"type": "string"
				},

				"underline": {
					"description": "A section only: a line under it in the strip.",
					"type": "boolean"
				},

				"create": {
					"type": "boolean"
				},

				"grow": {
					"description": "A spacer in the array of sections, written alone - { \"grow\": true }: the sections after it are pushed to the end of the strip.",
					"type": "boolean"
				},

				"roles": {
					"description": "Whose workplace the section is: seen by a user holding one of these roles (and only while an entry is left in it). Not written - the section is everyone's. Read on first-level items only, and only under app.json 'useGrants'; the admin sees all. Keys of app.json 'roles', or 'Everyone'.",
					"type": "array",
					"items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
					"minItems": 1,
					"uniqueItems": true
				},

				"row": {
					"description": "Row of the item in the section panel (see root 'columns'), 1-based as CSS grid-row. Read on second-level items only.",
					"type": "integer",
					"minimum": 1
				},

				"col": {
					"description": "Column of the item in the section panel (see root 'columns'), 1-based as CSS grid-column. Read on second-level items only.",
					"type": "integer",
					"minimum": 1
				},

				"items": {
					"description": "What the node holds: a section its subsections, a subsection its items, an aux its rows.",
					"type": "array",
					"items": {
						"$ref": "#/definitions/menuItem"
					}
				}
			},

			"anyOf": [
				{
					"required": [ "grow" ]
				},
				{
					"required": [ "title" ]
				}
			]
		}
	}
}