<html lang="uk">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="format-detection" content="telephone=no" />
	<meta name="google" content="notranslate" />
	<title></title>
	@Html.Raw(Model.Theme)
	@Html.Raw(codeProvider.AppStyleSheetsLink())
	<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
	<link rel="icon" href="/favicon.ico" type="image/x-icon" />
</head>
<body class="@appTheme.BodyCssClass">
	@* v-cloak only for a page with an app (it defines Scripts): a page without one stays as rendered *@
	<div id="app" class="shell login-shell" @Html.Raw(IsSectionDefined("Scripts") ? "v-cloak" : "")>
		<header class="header">
			<a class="h-block" href="/">
				@if (hasLogo) {
					<div class="app-logo"><img src="@logoUrl"/></div>
				} else {
					<span class=app-title>@Model?.Title?.AppTitle</span>
					<span class=app-subtitle>@Model?.Title?.AppSubTitle</span>
				}
			</a>
		</header>
		<div class="main-view">
			<div class="content-view full-view">
				@RenderBody()
			</div>
		</div>
		<footer class=footer>
			<span>
				<a target=_blank tabindex="-1" href="https://a2v10.com"><i class="ico ico-a2logo a2logo-layout"></i></a>
				<span>version</span>&nbsp;
				<span>@appVersion.AppVersion</span>
			</span>
		</footer>
	</div>
	@* The locale and Vue 3 as a2v10.platform.Vue: the same files and URLs the shell loads next, so after the login they
	   come from the cache. std:validators reads window.$$locale when first required, so the locale goes first.
	   Only the runtime and the std:* modules are taken; the page's app is not the shell's and is not attached to the platform. *@
	<script type="text/javascript" src="/scripts/locale-@Html.Raw(currentUser.Locale.Language + ".min.js")?v=@appVersion.AppBuild"></script>
	<script type="text/javascript" src="/scripts/vue3/a2v10-core.@Html.Raw(minify)js?v=@appVersion.AppBuild"></script>
	<script type="text/javascript">
		'use strict';
		@Html.Partial("/Views/Shared/_IdentityPost.cshtml")

		// the page's one app: its script passes the options, the frame mounts them on #app
		window.__identityApp = function (options) {
			const app = a2v10.platform.Vue.createApp(options);
			// v-focus: the input's group is marked while it has the focus, the first click selects the text,
			// the input with tabindex 1 takes the focus when the page opens
			app.directive('focus', {
				beforeMount(el) {
					el.addEventListener('focus', ev => ev.target.parentElement.classList.add('focus'));
					el.addEventListener('blur', ev => {
						ev.target._selectDone = false;
						ev.target.parentElement.classList.remove('focus');
					});
					el.addEventListener('click', ev => {
						const t = ev.target;
						if (t._selectDone) return;
						t._selectDone = true;
						if (t.select) t.select();
					});
				},
				mounted(el) {
					if (el.tabIndex !== 1) return;
					setTimeout(() => {
						if (el.focus) el.focus();
						if (el.select) el.select();
					}, 0);
				}
			});
			app.mount('#app');
		};
	</script>
	@RenderSection("scripts", required: false)
</body>
</html>
