@inject ILocalizer _loc
@inject IOptions<IdentityOptions> _identityOptions
@model InviteViewModel
@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Text.Unicode
@*
	The acceptance of an invitation without a framework: the server's data, the rules in the model core's format (std:validators), the submit.
	An expression: a framework's view takes it as `const page = <this partial>;` and binds its own markup to it.
	The validators, the mask and the redirect are the view's: this box reaches no runtime and no window.location; it posts by __identityPost.
*@
@{
	var data = new
	{
		init = new
		{
			email = Model.Login ?? String.Empty, // the invited user's: shown, not edited
			token = Model.Token, // the email confirmation token of the invitation
			requestToken = Model.RequestToken,
			// what UserManager checks: the host's identity options, ConfigureDefaultIdentityOptions unless it gives its own
			passwordLength = _identityOptions.Value.Password.RequiredLength,
			phoneMask = PhoneMask.Value
		},
		texts = new
		{
			enterName = _loc["EnterName"],
			enterPassword = _loc["EnterPassword"],
			passwordLength = _loc["PasswordLength"],
			matchError = _loc["MatchError"],
			errors = new Dictionary<String, String?>
			{
				["AntiForgery"] = _loc["AntiForgery"]
			}
		}
	};
}
(function () {
	@* Cyrillic as is, for reading in the debugger; <>&' stay escaped: the JSON cannot close the <script> *@
	const data = @Html.Raw(JsonSerializer.Serialize(data, new JsonSerializerOptions { Encoder = JavaScriptEncoder.Create(UnicodeRanges.BasicLatin, UnicodeRanges.Cyrillic) }));
	const texts = data.texts;
	return {
		init: data.init,
		// '#': a digit; the state keeps the digits only
		phoneMask: data.init.phoneMask,
		// by the state's member; a string is notBlank with that message, a function gets (state, value)
		rules: {
			name: texts.enterName,
			password: [texts.enterPassword, (s, v) => v.length < data.init.passwordLength ? texts.passwordLength : ''],
			confirm: (s, v) => !v || v !== s.password ? texts.matchError : ''
		},
		// state: { name, phone, password } → { url } to go to (signed in), or { error } to show
		async submit(state) {
			const result = await __identityPost('/account/invite', {
				Login: data.init.email,
				PersonName: state.name,
				Phone: state.phone,
				Password: state.password,
				Token: data.init.token
			}, data.init.requestToken);
			if (result.code)
				return { error: texts.errors[result.code] || result.code };
			return result;
		}
	};
})()
