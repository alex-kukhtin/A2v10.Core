
@model LoginViewModel
@inject ILocalizer _loc
@inject IOptions<AppOptions> _appOptions

<div class="center-page">
	<div class="initial-form">
		<h3 class="a2-header text-center">@Html.Raw(_loc["LoginPrompt"])</h3>
		<hr />
		<div v-if="serverError" class="validation-summary" style="margin-top:10px">
			<span class="error" v-text="serverError"></span>
		</div>
		<div v-if="providers.length">
			<div class="external-providers">
				<a v-for="ep in providers" :href="providerHref(ep)"
						class="btn btn btn-outline btn-logo">
					<img :src="providerLogo(ep)" /><span>@Html.Raw(_loc["SignInWith"])&nbsp;<span v-text="ep" class="provider-name"></span></span>
				</a>
			</div>
			<div class="or-line"><span class="or-span">@Html.Raw(_loc["Or"])</span></div>
		</div>
		<div>
			<div class="control-group" v-bind:class="{invalid: !!errors.email}">
				<label for="login" style="grid-row:1; grid-column:1" class="a2-label required">@Html.Raw(_loc["Email"])</label>
				<div class="input-group">
					<input v-focus class="control" id="login" name="email" type="text" v-model="email" tabindex="1" v-on:keyup.enter="onLoginEnter" autocomplete="email" spellcheck="false" />
					<div class="validator" v-if="errors.email">
						<span class="error" v-text="errors.email"></span>
					</div>
				</div>
			</div>
			<div class="control-group" v-bind:class="{invalid: !!errors.password}">
				<label for="password" style="grid-row:2; grid-column:1" class="a2-label required">@Html.Raw(_loc["Password"])</label>
				<div class="input-group">
					<input class="control" v-focus type="password" id="password" name="password" v-model="password" autocomplete="current-password" tabindex="2" v-on:keydown.enter.stop.prevent="submit" ref="pwd" />
					<a class="add-on" v-on:pointerdown="eyeDown($event)" v-on:pointerup="eyeUp($event)"><i class="ico ico-eye"></i></a>
					<div class="validator" v-if="errors.password">
						<span class="error" v-text="errors.password"></span>
					</div>
				</div>
			</div>
			<label class="checkbox">
				<input type="checkbox" v-model="rememberMe" tabindex="3" />
				<span>@Html.Raw(_loc["RememberCredentials"])</span>
			</label>

			<button v-on:click.stop.prevent="submit" class="btn btn-default" tabindex="4">@Html.Raw(_loc["Login"])</button>
			<a class="a2-hyperlink" href="/account/forgotpassword" tabindex="6">@Html.Raw(_loc["ForgotPassword"])</a>
		</div>

		@if (_appOptions.Value.Registration)
		{
			<a class="a2-hyperlink" href="/account/register" tabindex="7">@Html.Raw(_loc["RegisterLink"])</a>
		}
	</div>
</div>

@section Scripts
{
<script type="text/javascript">
'use strict';
(function () {

const page = @await Html.PartialAsync("~/Views/Account/LoginPage.cshtml", Model);
const validators = a2v10.platform.require('std:validators');

// the first error of the member's rules, or ''
function errorOf(rule, state, value) {
	const errs = validators.validate(rule, state, value);
	return errs.length ? errs[0].msg : '';
}

__identityApp({
	data() {
		return {
			email: page.init.email,
			password: '',
			rememberMe: true,
			submitted: false,
			serverError: '',
			providers: page.init.providers
		};
	},
	computed: {
		// shown after the first submit, as the user edits
		errors() {
			if (!this.submitted) return {};
			return {
				email: errorOf(page.rules.email, this, this.email),
				password: errorOf(page.rules.password, this, this.password)
			};
		}
	},
	methods: {
		providerLogo(provider) {
			return `/img/logo/${provider.toLowerCase()}.svg`;
		},
		providerHref(provider) {
			return `/account/openidlogin?provider=${provider}`;
		},
		onLoginEnter() {
			this.$refs.pwd.focus();
		},
		async submit() {
			this.submitted = true;
			if (this.errors.email || this.errors.password) return;
			const result = await page.submit({ email: this.email, password: this.password, rememberMe: this.rememberMe });
			if (result.url)
				window.location.replace(result.url);
			else
				this.serverError = result.error;
		},
		eyeDown(ev) {
			ev.preventDefault();
			ev.target.closest('.add-on').setPointerCapture(ev.pointerId);
			this.$refs.pwd.type = 'text';
		},
		eyeUp(ev) {
			ev.preventDefault();
			ev.target.closest('.add-on').releasePointerCapture(ev.pointerId);
			this.$refs.pwd.type = 'password';
		}
	}
});
})();
</script>
}
