@inject ILocalizer _loc
@model ConfirmCodeViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Text.Unicode
@*
	The confirmation of the registration's code without a framework: the server's data, the rules in the model core's format
	(std:validators), the submit. An expression: a framework's view takes it as `const page = <this partial>;` and binds its own markup to it.
	The validators and the redirect are the view's: this box reaches no runtime and no window.location; it posts by __identityPost.
*@
@{
	var data = new
	{
		init = new
		{
			email = Model.Email ?? String.Empty,
			token = Model.Token, // the protected user name, not the antiforgery token
			requestToken = Model.RequestToken
		},
		texts = new
		{
			enterConfirmCode = _loc["EnterConfirmCode"],
			errorText = _loc["ErrorText"], // any code not below
			errors = new Dictionary<String, String?>
			{
				["AlreadyConfirmed"] = _loc["EMailAlreadyConfirmed"],
				["InvalidConfirmCode"] = _loc["InvalidConfirmCode"],
				["AntiForgery"] = _loc["AntiForgery"]
			}
		}
	};
}
(function () {
	@* Cyrillic as is, for reading in the debugger; <>&' stay escaped: the JSON cannot close the <script> *@
	const data = @Html.Raw(JsonSerializer.Serialize(data, new JsonSerializerOptions { Encoder = JavaScriptEncoder.Create(UnicodeRanges.BasicLatin, UnicodeRanges.Cyrillic) }));
	const texts = data.texts;
	return {
		// by the state's member; a string is notBlank with that message
		rules: {
			code: texts.enterConfirmCode
		},
		// state: { code } → { url } to go to (signed in), or { error } to show
		async submit(state) {
			const result = await __identityPost('/account/confirmcode', {
				Email: data.init.email,
				Code: state.code.trim(),
				Token: data.init.token
			}, data.init.requestToken);
			if (result.code)
				return { error: texts.errors[result.code] || texts.errorText };
			return result;
		}
	};
})()
