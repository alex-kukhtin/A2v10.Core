@inject ILocalizer _loc
@model SimpleIdentityViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Text.Unicode
@*
	The reset of a forgotten password without a framework, in three steps: email → code → password. Each step has its rules
	in the model core's format (std:validators) and its submit; a step answers the next step's name, or where to go.
	An expression: a framework's view takes it as `const page = <this partial>;` and binds its own markup to it.
	The validators and the redirect are the view's: this box reaches no runtime and no window.location; it posts by __identityPost.
*@
@{
	var data = new
	{
		init = new
		{
			requestToken = Model.RequestToken
		},
		texts = new
		{
			confirmReset = _loc["ConfirmReset"], // {0}: the email
			enterEmail = _loc["EnterEMail"],
			invalidEmail = _loc["InvalidEMail"],
			enterConfirmCode = _loc["EnterConfirmCode"],
			enterPassword = _loc["EnterPassword"],
			matchError = _loc["MatchError"],
			errors = new Dictionary<String, String?>
			{
				["Failed"] = _loc["ErrorText"],
				["InvalidCode"] = _loc["InvalidConfirmCode"],
				["AntiForgery"] = _loc["AntiForgery"],
				["NotAllowed"] = _loc["ResetPasswordNotAllowed"]
			}
		}
	};
}
(function () {
	@* Cyrillic as is, for reading in the debugger; <>&' stay escaped: the JSON cannot close the <script> *@
	const data = @Html.Raw(JsonSerializer.Serialize(data, new JsonSerializerOptions { Encoder = JavaScriptEncoder.Create(UnicodeRanges.BasicLatin, UnicodeRanges.Cyrillic) }));
	const texts = data.texts;

	async function post(url, fields) {
		const result = await __identityPost(url, fields, data.init.requestToken);
		if (result.code)
			return { error: texts.errors[result.code] || result.code };
		return result;
	}

	return {
		first: 'email',
		confirmText: email => texts.confirmReset.replace('{0}', email),
		// by the step's name; rules by the state's member: a string is notBlank with that message, a function gets (state, value)
		// submit: state { email, code, password } → { next } step, { url } to go to, or { error } to show
		steps: {
			email: {
				rules: {
					email: [texts.enterEmail, { valid: 'email', msg: texts.invalidEmail }]
				},
				async submit(state) {
					// the server answers success for an unknown email too: it does not tell which addresses exist
					const result = await post('/account/forgotpassword', { Login: state.email });
					return result.error ? result : { next: 'code' };
				}
			},
			code: {
				rules: {
					code: texts.enterConfirmCode
				},
				async submit(state) {
					const result = await post('/account/checkforgotpasswordcode', { Login: state.email, Code: state.code });
					return result.error ? result : { next: 'password' };
				}
			},
			password: {
				rules: {
					password: texts.enterPassword,
					confirm: (s, v) => v !== s.password ? texts.matchError : ''
				},
				// success is the login page
				submit(state) {
					return post('/account/resetpassword', { Login: state.email, Code: state.code, Password: state.password });
				}
			}
		}
	};
})()
