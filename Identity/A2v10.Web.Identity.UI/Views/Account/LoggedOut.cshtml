
@inject ILocalizer _loc
@* No logic and no app: one view for every framework, no Scripts section (the layout leaves out v-cloak) *@

<div class="center-page">
	<div class="initial-form">
		<h3 class="a2-header text-center">@Html.Raw(_loc["LogOutPrompt"])</h3>
		<hr />
		<div>
			<p>@Html.Raw(_loc["LogOutMessage"])</p>
			<a class="btn btn-primary" href="/account/login" tabindex="1">@Html.Raw(_loc["LoginAgain"])</a>
		</div>

	</div>
</div>
