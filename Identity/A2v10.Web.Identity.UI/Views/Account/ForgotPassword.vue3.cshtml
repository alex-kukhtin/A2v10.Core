
@model SimpleIdentityViewModel
@inject ILocalizer _loc

<div class="center-page">
	<div class="initial-form">
		<h3 class="a2-header text-center">@Html.Raw(_loc["ForgotPrompt"])</h3>
		<hr />
		<div v-if="serverError" class="validation-summary" style="margin-top:10px">
			<span class="error" v-text="serverError"></span>
		</div>
		<div v-if="step === 'email'">
			<div class="control-group" v-bind:class="{invalid: !!errors.email}">
				<label class="a2-label required">@Html.Raw(_loc["Email"])</label>
				<div class="input-group">
					<input v-focus class="control" type="text" v-model="email" tabindex="1" spellcheck="false" name="email" ref="email" />
					<div class="validator">
						<span class="error" v-text="errors.email"></span>
					</div>
				</div>
			</div>
			<button v-on:click.stop.prevent="submit" class="btn btn-default" tabindex="2">@Html.Raw(_loc["Continue"])</button>
		</div>
		<div v-if="step === 'code'">
			<p v-text="confirmText"></p>

			<div class="control-group bold" v-bind:class="{invalid: !!errors.code}" style="width:15rem;margin:0 auto;">
				<label class="a2-label required">@Html.Raw(_loc["ConfirmCode"])</label>
				<div class="input-group">
					<input v-focus class="control text-center" type="text" v-model="code" tabindex="4" spellcheck="false" ref="code" />
					<div class="validator">
						<span class="error" v-text="errors.code"></span>
					</div>
				</div>
			</div>

			<button v-on:click.stop.prevent="submit" class="btn btn-default" tabindex="5">@Html.Raw(_loc["Continue"])</button>
		</div>

		<div v-if="step === 'password'">
			<div class="control-group">
				<label class="a2-label">@Html.Raw(_loc["Email"])</label>
				<div class="input-group static">
					<span class="static-input" v-text="email"></span>
				</div>
			</div>
			<div class="control-group" v-bind:class="{invalid: !!errors.password}">
				<label class="a2-label required" >@Html.Raw(_loc["Password"])</label>
				<div class="input-group">
					<input class="control" v-focus type="password" v-model="password" tabindex="6" autocomplete="off" ref="password" />
					<div class="validator">
						<span class="error" v-text="errors.password"></span>
					</div>
				</div>
			</div>
			<div class="control-group" v-bind:class="{invalid: !!errors.confirm}">
				<label class="a2-label required">@Html.Raw(_loc["Confirm"])</label>
				<div class="input-group">
					<input class="control" v-focus type="password" v-model="confirm" autocomplete="off"
						   tabindex="7" title="@_loc["PasswordTip"]" />
					<div class="validator">
						<span class="error" v-text="errors.confirm"></span>
					</div>
				</div>
			</div>
			<button v-on:click.stop.prevent="submit" tabindex="8" class="btn btn-default">@Html.Raw(_loc["ResetPassword"])</button>
		</div>
		<a tabindex="3" href="/" class="a2-hyperlink">@Html.Raw(_loc["Login"])</a>
	</div>
</div>

@section Scripts
{
<script type="text/javascript">
'use strict';
(function () {

const page = @await Html.PartialAsync("~/Views/Account/ForgotPasswordPage.cshtml", Model);
const validators = a2v10.platform.require('std:validators');

// the first error of the member's rules, or ''
function errorOf(rule, state, value) {
	const errs = validators.validate(rule, state, value);
	return errs.length ? errs[0].msg : '';
}

__identityApp({
	data() {
		return {
			step: page.first,
			email: '',
			code: '',
			password: '',
			confirm: '',
			submitted: false,
			serverError: ''
		};
	},
	computed: {
		confirmText() {
			return page.confirmText(this.email);
		},
		// by the current step's rules; shown after the step's first submit, as the user edits
		errors() {
			if (!this.submitted) return {};
			const rules = page.steps[this.step].rules;
			return Object.fromEntries(Object.entries(rules).map(([key, rule]) => [key, errorOf(rule, this, this[key])]));
		}
	},
	methods: {
		async submit() {
			this.submitted = true;
			this.serverError = '';
			if (Object.values(this.errors).some(e => e)) return;
			const result = await page.steps[this.step].submit({ email: this.email, code: this.code, password: this.password });
			if (result.url)
				window.location.replace(result.url);
			else if (result.next) {
				this.step = result.next;
				this.submitted = false;
				// the step's first input has the step's name as its ref
				await this.$nextTick();
				this.$refs[this.step]?.focus();
			}
			else
				this.serverError = result.error;
		}
	}
});
})();
</script>
}
